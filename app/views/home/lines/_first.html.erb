<!-- begin first line -->
<!-- bande haute -->
<div class="bw-2 bh-2">
    <%= render 'home/components/figure_img', date: 'Le 20 juin 2020', location: 'Au Saintes-Marie-de-la-Mer', img_asset: 'paul_sunset', img_desc: 'Paul au Saintes-Marie-de-la-Mer devant un coucher de soleil' %>
</div>
<div class="bw-4 bh-2 bw-md-2">
    <%= render 'home/components/resume' %>
</div>
<div class="bw-2 bh-2">
    <%= render 'home/components/figure_video', date: 'Le 16 septembre 2022', location: 'À Paris', video_asset: 'paul_in_paris_square' %>
</div>
<div class="bw-2 bh-4">
    <%= render 'home/components/figure_img', date: 'Le 29 juillet 2020', location: 'À La Faurie', img_asset: 'paul_bike_ride', img_desc: 'Paul en promenade sur son vélo à La Faurie' %>
</div>
<!-- bande basse -->
<div class="bw-2 bh-2">
    <div class="subgrid subgrid-2">
        <%= render 'home/components/brand', text: 'Page Wikipédia', link: nil, media: 'brands/logo-wikipedia', alt: 'logo Wikipédia', disabled: true %>
        <%= render 'home/components/brand', text: 'Fiche Wikidata', link: 'https://www.wikidata.org/wiki/Q130558045', media: 'brands/logo-wikidata', alt: 'logo Wikidata' %>
        <div class="span-all">
            <%= render 'home/components/card', title: 'Nous soutenir', text: 'en faisant un don', link: 'https://tribee.fr/cagnotte/7X0759Q6728MYAKQJKJVEGKKMY/participer' %>
        </div>
    </div>
</div>
<div class="bw-2 bh-2">
    <div class="subgrid subgrid-2">
        <div class="span-all">
            <%= render 'home/components/card', title: '# Stop violences Motorisées', text: 'signez et/ou témoignez', link: 'https://stopviolencesmotorisees.org', color: 'primary' %>
        </div>
        <%= render 'home/components/brand', text: 'Fédération française des usagers de la bicyclette', link: 'https://www.fub.fr', media: 'brands/logo-fub', alt: 'logo Fédération française des usagers de la bicyclette' %>
        <%= render 'home/components/brand', text: 'Mieux se déplacer à bicyclette', link: 'https://mdb-idf.org', media: 'brands/logo-mdb', alt: 'logo Mieux se déplacer à bicyclette' %>
    </div>
</div>
<div class="bw-4 bh-2 bw-md-2">
    <%= render 'home/components/message' %>
</div>
<!-- end first line -->
