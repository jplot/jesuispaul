<!-- begin second line -->
<div class="bw-2 bh-2">
    <%= render 'home/components/figure_img', date: 'En 2022', location: 'Au Forum des Associations de Paris Centre', img_asset: 'paul_pes', img_desc: 'Paul Au Forum des Associations de Paris Centre' %>
</div>
<div class="bw-2 bh-2">
    <div class="numbers-stack">
        <%= render 'home/components/numbers', idx: 0, type: 'person', icon: 'person-standing', numbers: [[[501, 'piétons tués en 2025', 10], [1942, 'blessés graves en 2025', -2]],[[456, 'piétons tués en 2024', 4], [1977, 'blessés graves en 2024', -1]], [[439, 'piétons tués en 2023'], [2006, 'blessés graves en 2023']]]%>
        <%= render 'home/components/numbers', idx: 1, type: 'cycle', icon: 'bicycle', numbers: [[[234, 'cyclistes tués en 2025', 4], [2778, 'blessés graves en 2025', 8]],[[224, 'cyclistes tués en 2024', 1], [2577, 'blessés graves en 2024', 1]], [[221, 'cyclistes tués en 2023'], [2543, 'blessés graves en 2023']]]%>
        <%= render 'home/components/numbers', idx: 2, type: 'scooter', icon: 'scooter', numbers: [[[80, 'usagers tués en EDPM* en 2025', 78], [1106, 'blessés graves en 2025', 33]],[[45, 'usagers tués en EDPM* en 2024', 2], [833, 'blessés graves en 2024', 24]], [[44, 'usagers tués en EDPM* en 2023'], [671, 'blessés graves en 2023']]]%>
    </div>
</div>
<div class="bw-2 bh-2">
    <div class="subgrid subgrid-2">
        <%= render 'home/components/brand', text: 'Paris en Selle', link: 'https://parisenselle.fr', media: 'brands/logo-pes', alt: 'logo Paris en Selle' %>
        <%= render 'home/components/brand', text: 'L’Atelier solidaire', link: 'https://atelierso.fr', media: 'brands/logo-as', alt: 'logo L’Atelier solidaire' %>
        <div class="span-all">
            <%= render 'home/components/book', title: 'Livre blanc pour le développement des déplacements à vélo et des espaces piétons', text: 'Saint-Ouen-sur-Seine, co-écrit par Paul', link: '#', color: 'warning' %>
        </div>
    </div>
</div>
<div class="bw-2 bh-2">
    <%= render 'home/components/figure_img', date: 'Le 3 mars 2024', location: 'À Paris', img_asset: 'paul_bike', img_desc: 'Paul transportant un matelas sur son vélo à Paris' %>
</div>
<div class="bw-2 bh-2">
    <%= render 'home/components/figure_img', date: 'Le 31 octobre 2020', location: 'À La Faurie', img_asset: 'paul_mountain', img_desc: 'Paul se promenant dans les montagnes de La Faurie' %>
</div>
<!-- end second line -->
